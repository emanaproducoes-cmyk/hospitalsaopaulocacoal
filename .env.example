# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://hospitalsaopaulocacoal.vercel.app

# ===== Medição (GA4 via Google Tag Manager, com Consent Mode v2) =====
# Sem este ID, os eventos ficam só no dataLayer e nada é enviado.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===== Hub de pedidos → CRM (servidor: /api/leads) =====
# Backend do hospital (Java/Spring, contrato em docs/api/openapi.yaml)
HBSP_API_URL=
HBSP_API_TOKEN=
# Qualquer CRM via webhook (n8n, Make, Zapier, RD Station, HubSpot, Kommo, Pipedrive…)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ===== Assistente com IA (servidor: /api/assistant) =====
# Sem chave, o assistente funciona por regras (catálogo do site), sem IA generativa.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ===== Hospedagem estática (opcional) =====
# NEXT_OUTPUT=export  → /api/* não existe; o site cai no WhatsApp e gera o protocolo no navegador.
# NEXT_PUBLIC_LEADS_ENDPOINT=https://api.seudominio/leads
# NEXT_PUBLIC_ASSISTANT_ENDPOINT=https://api.seudominio/assistant

# ===== Ambiente seguro: área do paciente / área do médico (servidor) =====
# Sem SUPABASE_*, roda em MODO DEMONSTRAÇÃO (dados fictícios, em memória). Nunca use dados reais nele.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=prontuario
# Chaves de criptografia: gere com  openssl rand -base64 32  (uma por chave). Guarde cópia offline.
HBSP_DATA_KEYS=k1:COLE_AQUI_32_BYTES_BASE64
HBSP_ACTIVE_KEY=k1
HBSP_INDEX_KEY=
HBSP_SESSION_PEPPER=
# E-mail transacional (códigos de acesso e avisos)
RESEND_API_KEY=
MAIL_FROM=Hospital São Paulo <seguranca@seudominio.com.br>
# Login com Google (Google Cloud Console → OAuth; redirect: <site>/api/secure/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alertas de tentativa de invasão e primeiro administrador
SECURITY_ALERT_EMAIL=
HBSP_ADMIN_EMAIL=
