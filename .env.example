# URL pública do site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.hospitalsaopaulocacoal.com.br
# API do backend Java (Spring Boot). Se vazio, formulários usam WhatsApp como fallback.
NEXT_PUBLIC_API_URL=
# Google Tag Manager (carregado somente após consentimento)
NEXT_PUBLIC_GTM_ID=
# Mostrar selos "a validar" nos dados ainda não confirmados pelo hospital
NEXT_PUBLIC_SHOW_VALIDATION_FLAGS=true
